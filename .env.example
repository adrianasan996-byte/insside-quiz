# Copia este archivo como .env y completa los valores.

# (Opcional) URL a la que se hará POST con el lead + resultado del quiz.
# Puede ser un webhook de Zapier/Make, un endpoint de Google Apps Script,
# un Formspree, o tu propio backend. Si se deja vacío, el quiz solo guarda
# en localStorage.
#
# Payload enviado (JSON):
# {
#   "nombre": string,
#   "email": string | "",
#   "perfil": string,          // p.ej. "Ansiedad rumiante"
#   "nivel": string,           // p.ej. "Sobrecarga"
#   "puntaje": number,         // 0-100
#   "subescalas": { rumia: number, control: number, social: number, rendimiento: number, somatica: number },
#   "fecha": string            // ISO
# }
VITE_LEAD_WEBHOOK=
