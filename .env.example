# Variables de SERVIDOR (no llevan prefijo VITE_ → nunca llegan al navegador).
# Se configuran en Vercel: Project → Settings → Environment Variables.
# NO las pegues en el repo ni en el código.

# URL del "Inbound Webhook" del workflow de GoHighLevel que recibe los tests
# COMPLETOS (el que manda el correo de resultados). La usa api/lead.ts.
GHL_WEBHOOK_URL=

# Opcional: "Inbound Webhook" de un segundo workflow que solo guarda el contacto
# apenas llena el form (aunque no termine el test). Sin correos. Si se deja
# vacía, los envíos parciales no se mandan a ningún lado.
GHL_WEBHOOK_URL_PARCIAL=
